rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Security Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation: User Profile & Career
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80 &&
             data.cashBalance is number &&
             (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 80)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('selectedTeamId' in data) || (data.selectedTeamId is string && data.selectedTeamId.size() <= 64)) &&
             (!('selectedDriverId' in data) || (data.selectedDriverId is string && data.selectedDriverId.size() <= 64)) &&
             (!('difficulty' in data) || (data.difficulty in ['rookie', 'pro', 'legend'])) &&
             (!('racesEntered' in data) || data.racesEntered is number) &&
             (!('wins' in data) || data.wins is number) &&
             (!('podiums' in data) || data.podiums is number) &&
             (!('championshipPoints' in data) || data.championshipPoints is number) &&
             (!('customTeamName' in data) || (data.customTeamName is string && data.customTeamName.size() <= 80)) &&
             (!('seasonStateJson' in data) || data.seasonStateJson is string) &&
             (!('activeCareerSlotId' in data) || (data.activeCareerSlotId is string && data.activeCareerSlotId.size() <= 64)) &&
             (!('careerSlotsJson' in data) || data.careerSlotsJson is string) &&
             (!('activeMetroCitySlotId' in data) || (data.activeMetroCitySlotId is string && data.activeMetroCitySlotId.size() <= 64));
    }

    // Entity Validation: Metro City Multi-Slot Save (Native Firestore Maps/Lists)
    function isValidMetroCitySave(data, userId, slotId) {
      let requiredFields = [
        'slotId',
        'ownerUid',
        'slotName',
        'streetCash',
        'ownedCarIds',
        'selectedCarId',
        'completedMissions',
        'completedMissionIds',
        'totalEarnedCash',
        'streetRepLevel',
        'ownedHouseIds',
        'createdAt',
        'updatedAt'
      ];
      let allowedFields = [
        'slotId',
        'ownerUid',
        'slotName',
        'streetCash',
        'ownedCarIds',
        'selectedCarId',
        'customPaintByCar',
        'unlockedTrimsByCar',
        'activeTrimByCar',
        'completedMissions',
        'completedMissionIds',
        'totalEarnedCash',
        'streetRepLevel',
        'pendingMissionId',
        'ownedHouseIds',
        'activeHomeId',
        'houseFurnishings',
        'unpaidCrashTicketsTab',
        'totalJobsCompleted',
        'totalHeistsCompleted',
        'bankRobberyBustCount',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.slotId is string && isValidId(data.slotId) && data.slotId.size() <= 64 && data.slotId == slotId &&
             data.ownerUid is string && isValidId(data.ownerUid) && data.ownerUid == userId &&
             data.slotName is string && data.slotName.size() > 0 && data.slotName.size() <= 64 &&
             data.streetCash is number && data.streetCash >= -100000000 && data.streetCash <= 1000000000 &&
             data.ownedCarIds is list && data.ownedCarIds.size() >= 1 && data.ownedCarIds.size() <= 64 &&
             data.selectedCarId is string && data.selectedCarId.size() > 0 && data.selectedCarId.size() <= 64 &&
             (!('customPaintByCar' in data) || (data.customPaintByCar is map && data.customPaintByCar.size() <= 64)) &&
             (!('unlockedTrimsByCar' in data) || (data.unlockedTrimsByCar is map && data.unlockedTrimsByCar.size() <= 64)) &&
             (!('activeTrimByCar' in data) || (data.activeTrimByCar is map && data.activeTrimByCar.size() <= 64)) &&
             data.completedMissions is int && data.completedMissions >= 0 && data.completedMissions <= 500 &&
             data.completedMissionIds is list && data.completedMissionIds.size() <= 100 &&
             data.totalEarnedCash is number && data.totalEarnedCash >= 0 && data.totalEarnedCash <= 1000000000 &&
             data.streetRepLevel is int && data.streetRepLevel >= 1 && data.streetRepLevel <= 1000 &&
             (!('pendingMissionId' in data) || data.pendingMissionId == null || (data.pendingMissionId is string && data.pendingMissionId.size() <= 64)) &&
             data.ownedHouseIds is list && data.ownedHouseIds.size() <= 64 &&
             (!('activeHomeId' in data) || data.activeHomeId == null || (data.activeHomeId is string && data.activeHomeId.size() <= 64)) &&
             (!('houseFurnishings' in data) || (data.houseFurnishings is map && data.houseFurnishings.size() <= 64)) &&
             (!('unpaidCrashTicketsTab' in data) || (data.unpaidCrashTicketsTab is number && data.unpaidCrashTicketsTab >= 0 && data.unpaidCrashTicketsTab <= 100000000)) &&
             (!('totalJobsCompleted' in data) || (data.totalJobsCompleted is int && data.totalJobsCompleted >= 0 && data.totalJobsCompleted <= 100000)) &&
             (!('totalHeistsCompleted' in data) || (data.totalHeistsCompleted is int && data.totalHeistsCompleted >= 0 && data.totalHeistsCompleted <= 100000)) &&
             (!('bankRobberyBustCount' in data) || (data.bankRobberyBustCount is int && data.bankRobberyBustCount >= 0 && data.bankRobberyBustCount <= 100000));
    }

    // Entity Validation: Leaderboard Record
    function isValidLeaderboardRecord(data) {
      return data.circuitId is string && data.circuitId.size() > 0 && data.circuitId.size() <= 64 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.driverName is string && data.driverName.size() > 0 && data.driverName.size() <= 80 &&
             data.lapTimeSeconds is number && data.lapTimeSeconds > 20.0 && data.lapTimeSeconds < 600.0 &&
             data.lapTimeFormatted is string && data.lapTimeFormatted.size() <= 32 &&
             (!('teamId' in data) || (data.teamId is string && data.teamId.size() <= 64)) &&
             (!('carNumber' in data) || data.carNumber is number);
    }

    // Entity Validation: Grand Prix Race Result
    function isValidRaceResult(data) {
      return data.circuitId is string && data.circuitId.size() > 0 && data.circuitId.size() <= 64 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.position is number && data.position >= 1 && data.position <= 20 &&
             (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 80)) &&
             (!('teamId' in data) || (data.teamId is string && data.teamId.size() <= 64)) &&
             (!('totalLaps' in data) || data.totalLaps is number) &&
             (!('totalTimeSeconds' in data) || data.totalTimeSeconds is number) &&
             (!('bestLapSeconds' in data) || data.bestLapSeconds is number) &&
             (!('pointsAwarded' in data) || data.pointsAwarded is number);
    }

    // Test connection check rule
    match /test/connection {
      allow read: if isSignedIn() || resource == null;
    }

    // 1. User Profiles & Persistent Career Saves
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;

      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if false; // Protect career progress from accidental loss

      // 1B. Multi-Slot Metro City Saves (Strictly Owner-Scoped & Schema-Validated)
      match /metroCitySaves/{slotId} {
        allow get: if isOwner(userId) && isValidId(slotId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(slotId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isValidMetroCitySave(incoming(), userId, slotId);

        allow update: if isOwner(userId) &&
          isValidId(slotId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          incoming().slotId == existing().slotId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'slotName',
            'streetCash',
            'ownedCarIds',
            'selectedCarId',
            'customPaintByCar',
            'unlockedTrimsByCar',
            'activeTrimByCar',
            'completedMissions',
            'completedMissionIds',
            'totalEarnedCash',
            'streetRepLevel',
            'pendingMissionId',
            'ownedHouseIds',
            'activeHomeId',
            'houseFurnishings',
            'unpaidCrashTicketsTab',
            'totalJobsCompleted',
            'totalHeistsCompleted',
            'bankRobberyBustCount',
            'updatedAt'
          ]) &&
          isValidMetroCitySave(incoming(), userId, slotId);

        allow delete: if isOwner(userId) && isValidId(slotId);
      }
    }

    // 2. Circuit Hot Lap Leaderboards (Global Public Read, Authenticated Write)
    match /leaderboards/{circuitId}/records/{recordId} {
      allow get, list: if isValidId(circuitId); // Public lap time leaderboard

      allow create: if isSignedIn() &&
        isValidId(circuitId) && isValidId(recordId) &&
        incoming().circuitId == circuitId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isValidLeaderboardRecord(incoming());

      allow update, delete: if false; // Official lap records are immutable
    }

    // 3. Grand Prix Race Results Archive
    match /raceResults/{resultId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(resultId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isValidRaceResult(incoming());

      allow update, delete: if false; // Race finishes are permanent race records
    }

    // 4. Serverless Multiplayer Grand Prix Rooms & Global Developer Notes/Bug Reports
    match /rooms/{roomCode} {
      allow read: if isValidId(roomCode);
      allow write: if isValidId(roomCode);

      match /telemetry/{playerId} {
        allow read: if isValidId(roomCode) && isValidId(playerId);
        allow write: if isValidId(roomCode) && isValidId(playerId);
      }
    }
  }
}
